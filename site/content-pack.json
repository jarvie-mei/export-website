  "faq": [
    {
      "q_zh": "如何为叠放的餐盒选保温袋？",
      "a_zh": "将装好餐食的餐盒加盖，按实际配送方式叠放。记录最宽处的长、宽和叠放总高度，并在询盘中注明每袋装几盒、预计配送多久。",
      "q_en": "How should I measure stacked meal boxes for an insulated bag?",
      "a_en": "Fill and close the boxes, then stack them as they will travel. Record the length and width at the widest point and the total height. Include the number of boxes per bag and the expected delivery time in your inquiry."
    },
    {
      "q_zh": "咨询无腰线纸袋时，尺寸应怎样填写？",
      "a_zh": "请按“袋宽 × 侧宽 × 袋高”填写，并标明单位。袋宽指正面宽度，侧宽指撑开后的侧面宽度，袋高从袋底量至袋口，不含提手。",
      "q_en": "Which dimensions should I give for a paper bag?",
      "a_en": "Give the front width, the depth of the opened side gusset and the height from the base to the top edge. Exclude the handles and state the unit of measurement."
    }
  ]
}
